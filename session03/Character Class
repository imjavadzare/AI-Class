class Character:
    def __init__(self, name, power, health, coins):
        self.name = name
        self.power = power
        self.health = health
        self.coins = coins
        self.level = 1

    def show_info(self):
        print(
            f"{self.name} | Level: {self.level} | Power: {self.power} "
            f"| Health: {self.health} | Coins: {self.coins}"
        )

    def is_alive(self):
        return self.health > 0

    def attack(self, other):
        other.health -= self.power
        print(
            f"{self.name} attacked {other.name}. "
            f"{other.name}'s health: {other.health}"
        )

    def earn_coins(self, amount):
        self.coins += amount

    def buy_potion(self):
        if self.coins >= 20:
            self.coins -= 20
            self.health += 30
        else:
            print("Not enough coins")

    def level_up(self):
        self.level += 1
        self.power += 5
        print(
            f"{self.name} reached level {self.level}. "
            f"New power: {self.power}"
        )


arya = Character("Arya", 10, 100, 50)
bran = Character("Bran", 8, 100, 10)

arya.attack(bran)
bran.attack(arya)
arya.attack(bran)

arya.buy_potion()
bran.level_up()

arya.show_info()
bran.show_info()
